# BlueLockRPtelegrambot — sample environment file
# Copy to .env (git-ignored) and fill in. All values can also be set as
# real environment variables — .env is only a local fallback.

# Required — from @BotFather. The bot refuses to start without it.
BLUELOCK_BOT_TOKEN=123456:PUT-YOUR-BOTFATHER-TOKEN-HERE

# Admin usernames (no @), comma-separated — they get the admin panel.
BLUELOCK_ADMINS=thetamo,knight_ozuki,itoshi_rin_org

# Optional — admin Telegram user IDs instead of / in addition to usernames.
#BLUELOCK_ADMIN_IDS=123456789,987654321

# Optional — season number (default: 1).
#BLUELOCK_SEASON=1

# Optional — skill/passive system switch, 1 = on (default), 0 = off.
#BLUELOCK_ABILITIES=1
